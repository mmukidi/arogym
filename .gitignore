# Media stays out of this repository, except the live site under site/.
# site/ images and webfonts are committed and deployed to Cloudflare Pages.

# Raster images and screenshots
*.jpg
*.jpeg
*.png
*.webp
*.avif
*.gif
screens/
!site/**/*.jpg
!site/**/*.jpeg
!site/**/*.png
!site/**/*.webp
!site/**/*.avif
!site/**/*.gif

# Video and audio
*.mp4
*.mov
*.webm
*.mp3
*.wav
*.m4a
*.aac

# Binary fonts (woff/woff2 plus desktop font files)
*.woff
*.woff2
*.ttf
*.otf
*.eot
!site/**/*.woff
!site/**/*.woff2

# Archives
*.tar.gz
*.tgz
*.zip
*.tar

# Versioned binary asset drops
assets-v*/
